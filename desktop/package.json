{
  "name": "labrynth",
  "productName": "Labrynth",
  "version": "3.0.1-beta.8",
  "description": "Labrynth desktop shell: native window for the REACHER experiment control backend",
  "author": "Otis Lab <otislab@musc.edu>",
  "homepage": "https://github.com/Otis-Lab-MUSC/labrynth",
